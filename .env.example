# Webhook que recebe os leads do diagnóstico via POST JSON
# Payload: { name, whatsapp, email?, dominio?, nota?, origem, consentimento, recebidoEm }
LEAD_WEBHOOK_URL=

# Assinatura do diagnóstico (só servidor). Prova para /api/lead que o resultado
# foi calculado por /api/diagnostico. Gere com: openssl rand -hex 32
DIAGNOSTICO_SIGNING_SECRET=

# Núcleo Major: chama o lead no WhatsApp e avisa a equipe (só servidor).
# URL e chave publicável do projeto Supabase do NÚCLEO (não deste site), e o
# token que o SQL scripts/sql/ligar-campanha-do-site.sql do Núcleo devolveu.
# Com qualquer uma vazia, o lead não é encaminhado e o site segue igual.
NUCLEO_SUPABASE_URL=
NUCLEO_SUPABASE_KEY=
NUCLEO_LEAD_TOKEN=

# Supabase Auth
# Use somente a chave pública. Nunca coloque service_role em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://seu-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_exemplo

# Chave service_role — obrigatória para o Content Hub e o portal do cliente
# (/[portalSlug], /api/portal/*, /api/admin/content/*). Sem ela o login do
# portal responde 503. Pegue em Supabase > Project Settings > API Keys.
# Uso exclusivo no servidor: nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_exemplo

# Legacy fallback (optional):
SUPABASE_SERVICE_ROLE_KEY=